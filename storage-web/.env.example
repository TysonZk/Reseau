# Copier en .env et renseigner pour activer les alertes par webhook.
# docker compose lit automatiquement ce fichier.

# URL du webhook — Discord, Slack ou tout endpoint acceptant du JSON POST.
# Laisser vide pour désactiver les alertes.
ALERT_WEBHOOK_URL=

# Seuil d'alerte, en % d'utilisation (défaut 85).
ALERT_THRESHOLD=85

# Fréquence de vérification, en secondes (défaut 300 = 5 min).
ALERT_INTERVAL=300

# Format du webhook : auto | discord | slack | json
# "auto" détecte Discord/Slack depuis l'URL, sinon JSON générique.
ALERT_WEBHOOK_FORMAT=auto
